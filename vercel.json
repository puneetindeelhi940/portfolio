{
  "buildCommand": null,
  "outputDirectory": ".",
  "rewrites": [
    { "source": "/observatory", "destination": "/observatory/index.html" }
  ],
  "headers": [
    {
      "source": "/observatory/data/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=3600, s-maxage=86400" }
      ]
    }
  ]
}
